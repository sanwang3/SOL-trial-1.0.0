# Solana监控系统配置

# 监控地址（多个地址用逗号分隔）
WATCH_ADDR=你的Solana地址

# 数据源: ws 或 geyser
DATA_SOURCE=ws

# WebSocket端点
SOL_WS=wss://api.mainnet-beta.solana.com

# HTTP RPC端点
SOL_HTTP=https://api.mainnet-beta.solana.com

# Geyser gRPC端点（使用geyser数据源时必填）
GRPC_URL=
GRPC_X_TOKEN=

# 数据存储: postgres 或 clickhouse（留空不存储）
SINK=postgres

# PostgreSQL配置
DATABASE_URL=postgres://sol:sol@postgres:5432/sol_monitor
POSTGRES_PASSWORD=sol

# ClickHouse配置
CH_URL=http://clickhouse:8123
CH_USER=default
CH_PASS=changeme

# 告警推送配置
TG_BOT=
TG_CHAT=
WX_HOOK=

# Web管理界面配置
BIND_HOST=127.0.0.1
API_TOKEN=
